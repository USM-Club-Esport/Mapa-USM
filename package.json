    "@types/three": "^0.183.1",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.12",
    "expo-gl": "~16.0.10",
    "expo-image": "~3.0.11",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-three": "^8.0.0",
    "leaflet": "^1.9.4",
